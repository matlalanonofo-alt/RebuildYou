@model Opportunity
<div class="card ry-card h-100">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-start mb-2">
      <span class="badge badge-cat">@(Model.Category?.Name)</span>
      @if (Model.IsOpen) { <span class="badge text-bg-success">Open</span> } else { <span class="badge text-bg-secondary">Closed</span> }
    </div>
    <h3 class="h5">@Model.Title</h3>
    <p class="small mb-2 text-muted-ry">@Model.EmployerName</p>
    <ul class="list-unstyled small mb-3">
      <li><i class="bi bi-geo-alt"></i> @Model.Location</li>
      <li><i class="bi bi-briefcase"></i> @Model.Type</li>
      @if (!string.IsNullOrEmpty(Model.Salary)) { <li><i class="bi bi-cash"></i> @Model.Salary</li> }
      <li><i class="bi bi-calendar-event"></i> Closes @Model.Deadline.ToString("d MMMM yyyy")</li>
    </ul>
    <p class="small">@Model.ShortDescription</p>
    <a class="btn btn-ry mt-auto align-self-start" asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.Id">View Details</a>
  </div>
</div>
