@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignIn
@inject UserManager<ApplicationUser> Users
@inject IConfiguration Cfg
<!DOCTYPE html>
<html lang="en-ZA">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] ?? "Home") | RebuildYOU Training Centre</title>
  <meta name="description" content="Build skills. Create opportunities. Transform lives. Skills development, workplace readiness and career opportunities in Roodepoort, Johannesburg." />
  <link rel="icon" href="~/img/logo.svg" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
<a class="visually-hidden-focusable skip" href="#main">Skip to main content</a>
<nav class="navbar navbar-expand-xl navbar-light ry-nav sticky-top">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
      <img src="~/img/logo.svg" alt="" width="40" height="40" />
      <span class="lh-1"><span class="brand-main">REBUILD<span>YOU</span></span><small class="d-block brand-sub">TRAINING CENTRE</small></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Training" asp-action="Index">Courses</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Careers</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About Us</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact Us</a></li>
      </ul>
      <div class="d-flex gap-2 align-items-center">
      @if (SignIn.IsSignedIn(User))
      {
        <div class="dropdown">
          <button class="btn btn-ry-outline dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle"></i> @(Users.GetUserAsync(User).Result?.FirstName)</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">My Dashboard</a></li>
            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">My Profile</a></li>
            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="Cv">My CV</a></li>
            <li><a class="dropdown-item" asp-controller="Dashboard" asp-action="MyApplications">My Applications</a></li>
            @if (User.IsInRole("Admin")) { <li><hr class="dropdown-divider" /></li><li><a class="dropdown-item fw-semibold" asp-controller="Admin" asp-action="Index">Admin Dashboard</a></li> }
            <li><hr class="dropdown-divider" /></li>
            <li><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item">Log out</button></form></li>
          </ul>
        </div>
      }
      else
      {
        <a class="btn btn-ry-outline" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-ry" asp-controller="Account" asp-action="Register">Register</a>
      }
      </div>
    </div>
  </div>
</nav>
<main id="main">
  <div class="container pt-3">
    @if (TempData["Success"] is string ok) { <div class="alert alert-success" role="status"><i class="bi bi-check-circle"></i> @ok</div> }
    @if (TempData["Error"] is string er) { <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-circle"></i> @er</div> }
  </div>
  @RenderBody()
</main>
<footer class="ry-footer mt-5">
  <div class="container py-5">
    <div class="row g-4">
      <div class="col-lg-5">
        <div class="d-flex align-items-center gap-2 mb-2"><img src="~/img/logo.svg" alt="" width="36" height="36" /><strong class="brand-main">REBUILD<span>YOU</span></strong></div>
        <p class="mb-1">Build Skills. Create Opportunities. Transform Lives.</p>
        <p class="small text-muted-ry">Rebuild You Skills Academy (Pty) Ltd, trading as Rebuild You Training Centre. Applying through this website does not guarantee employment.</p>
      </div>
      <div class="col-6 col-lg-3"><h2 class="h6">Explore</h2>
        <ul class="list-unstyled small">
          <li><a asp-controller="Training" asp-action="Index">Training Programmes</a></li>
          <li><a asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
          <li><a asp-controller="Careers" asp-action="Index">Career Categories</a></li>
          <li><a asp-controller="Resources" asp-action="Index">Get Work-Ready tips</a></li>
          <li><a asp-controller="Home" asp-action="Employers">For Employers</a></li>
          <li><a asp-controller="Home" asp-action="Privacy">Privacy Notice</a></li>
        </ul></div>
      <div class="col-6 col-lg-4"><h2 class="h6">Contact</h2>
        <ul class="list-unstyled small">
          <li><i class="bi bi-geo-alt"></i> <a href="https://www.google.com/maps/search/?api=1&amp;query=2+Anderson+Street%2C+Davidsonville%2C+Roodepoort%2C+Johannesburg%2C+1724" target="_blank" rel="noopener">@Cfg["Site:Address"]</a></li>
          <li><i class="bi bi-telephone"></i> <a href="tel:+27656001164">@Cfg["Site:Phone"]</a></li>
          <li><i class="bi bi-whatsapp"></i> <a href="https://wa.me/27656001164" target="_blank" rel="noopener">Chat on WhatsApp</a></li>
          <li><i class="bi bi-envelope"></i> <a href="mailto:@Cfg["Site:Email"]">@Cfg["Site:Email"]</a></li>
          <li><i class="bi bi-instagram"></i> <a href="https://www.instagram.com/yourebuild?srtk=MWVxOHFldXJ4dXZ4Zg==" target="_blank" rel="noopener">Rebuild You</a></li>
          <li><i class="bi bi-facebook"></i> <a href="https://www.facebook.com/profile.php?id=61573300955838" target="_blank" rel="noopener">Rebuild You Training Centre</a></li>
        </ul></div>
    </div>
    <hr /><p class="small mb-0 text-muted-ry">&copy; @DateTime.Now.Year Rebuild You Skills Academy (Pty) Ltd. Empowering People. Building Futures.</p>
  </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script>document.querySelectorAll('[data-pw]').forEach(function(b){b.addEventListener('click',function(){var i=document.querySelector(b.dataset.pw),s=i.type==='password';i.type=s?'text':'password';b.textContent=s?'Hide':'Show';});});</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
