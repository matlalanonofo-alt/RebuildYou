@{ ViewData["Title"] = "For Employers"; }
<div class="container section narrow">
  <h1>For Employers</h1>
  <p class="lead">Looking for entry-level staff, learners or interns? Tell us what you need and we will get back to you.</p>
  <ul><li>Share a vacancy, learnership or internship</li><li>Ask us to help source and screen candidates</li><li>Enquire about workplace training for your team</li></ul>
  <p>Candidates on this platform complete one profile and upload a CV. We only share application details with you for the opportunity the person applied for.</p>
  <a class="btn btn-ry btn-lg" asp-action="Contact" asp-route-subject="Employer enquiry">Send an employer enquiry</a>
</div>
