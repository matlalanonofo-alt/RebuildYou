@model TrainingProgramme
@{ ViewData["Title"] = "Programme"; }
<div class="container section narrow"><h1>@(Model.Id == 0 ? "Add programme" : "Edit programme")</h1>
  <p class="small text-muted-ry">Only enter fees, duration, accreditation and requirements that RebuildYOU has confirmed. Blank fields show "To be confirmed".</p>
  <form asp-action="ProgrammeForm" method="post" novalidate><input type="hidden" asp-for="Id" />
    <div class="row g-3">
      <div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
      <div class="col-md-4"><label asp-for="Slug" class="form-label"></label><input asp-for="Slug" class="form-control" /><div class="form-text">Lowercase, hyphens, no spaces.</div><span asp-validation-for="Slug" class="text-danger"></span></div>
      <div class="col-12"><label asp-for="Summary" class="form-label"></label><input asp-for="Summary" class="form-control" /><span asp-validation-for="Summary" class="text-danger"></span></div>
      <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" rows="4" class="form-control"></textarea></div>
      <div class="col-12"><label asp-for="WhoIsItFor" class="form-label"></label><input asp-for="WhoIsItFor" class="form-control" /></div>
      <div class="col-12"><label asp-for="WhatYouGain" class="form-label"></label><textarea asp-for="WhatYouGain" rows="3" class="form-control"></textarea></div>
      <div class="col-12"><label asp-for="RelatedCategorySlug" class="form-label"></label><input asp-for="RelatedCategorySlug" class="form-control" /></div>
      <div class="col-12"><label asp-for="SkillsCovered" class="form-label"></label><textarea asp-for="SkillsCovered" rows="4" class="form-control"></textarea></div>
      <div class="col-md-6"><label asp-for="EntryRequirements" class="form-label"></label><input asp-for="EntryRequirements" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="Duration" class="form-label"></label><input asp-for="Duration" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="DeliveryMethod" class="form-label"></label><input asp-for="DeliveryMethod" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="StartDates" class="form-label"></label><input asp-for="StartDates" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="Fees" class="form-label"></label><input asp-for="Fees" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="Accreditation" class="form-label"></label><input asp-for="Accreditation" class="form-control" /></div>
      <div class="col-md-4"><label asp-for="Icon" class="form-label"></label><input asp-for="Icon" class="form-control" /></div>
      <div class="col-md-4"><label asp-for="SortOrder" class="form-label"></label><input asp-for="SortOrder" class="form-control" /></div>
      <div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Published</label></div></div>
    </div>
    <button class="btn btn-ry mt-4">Save</button> <a class="btn btn-ry-outline mt-4" asp-action="Programmes">Cancel</a>
  </form>
</div>
