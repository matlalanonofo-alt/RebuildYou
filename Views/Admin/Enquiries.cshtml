@model List<ContactEnquiry>
@{ ViewData["Title"] = "Enquiries"; }
<div class="container section"><h1>Contact enquiries</h1><partial name="_AdminNav" />
  @if (Model.Count == 0) { <div class="empty">No enquiries yet.</div> }
  @foreach (var e in Model) { <div class="feature mb-3"><div class="d-flex justify-content-between"><strong>@e.Subject</strong><span class="small text-muted-ry">@e.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</span></div>
    <p class="small mb-1">@e.Name &middot; <a href="mailto:@e.Email">@e.Email</a></p><p style="white-space:pre-line">@e.Message</p>
    @if (e.IsHandled) { <span class="badge text-bg-success">Handled</span> } else { <form asp-action="HandleEnquiry" asp-route-id="@e.Id" method="post"><button class="btn btn-sm btn-ry-outline">Mark as handled</button></form> }</div> }
</div>
