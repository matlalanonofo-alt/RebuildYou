@model List<ProgrammeInterest>
@{ ViewData["Title"] = "Programme interest"; }
<div class="container section"><h1>Programme interest</h1><partial name="_AdminNav" />
  @if (Model.Count == 0) { <div class="empty">Nobody has registered interest yet.</div> }
  else { <div class="table-responsive"><table class="table ry-table align-middle"><thead><tr><th>Programme</th><th>Name</th><th>Mobile</th><th>Email</th><th>Date</th></tr></thead><tbody>
  @foreach (var i in Model) { <tr><td>@i.Programme?.Title</td><td>@i.User?.FullName</td><td>@i.User?.PhoneNumber</td><td>@i.User?.Email</td><td>@i.At.ToLocalTime().ToString("d MMM yyyy")</td></tr> }
  </tbody></table></div> }
</div>
