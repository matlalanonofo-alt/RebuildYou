@model List<LoginRecord>
@{ ViewData["Title"] = "Login activity"; }
<div class="container section"><h1>Login activity</h1><partial name="_AdminNav" />
  <form method="get" class="row g-2 mb-3"><div class="col-md-4"><label class="form-label small" for="q">Email</label><input id="q" name="q" value="@ViewBag.Q" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label small" for="ev">Event</label><select id="ev" name="ev" class="form-select"><option value="">All</option>@foreach (var e in new[] { "Registered", "Login", "Failed login", "Locked out" }) { <option value="@e" selected="@((string?)ViewBag.Ev == e)">@e</option> }</select></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-ry">Filter</button></div></form>
  @if (Model.Count == 0) { <div class="empty">No activity recorded yet.</div> }
  else { <div class="table-responsive"><table class="table ry-table align-middle"><thead><tr><th>When</th><th>Email</th><th>Event</th><th>IP address</th><th></th></tr></thead><tbody>
  @foreach (var l in Model) { <tr><td>@l.At.ToLocalTime().ToString("d MMM yyyy HH:mm")</td><td>@l.Email</td><td><span class="badge @(l.Event == "Login" || l.Event == "Registered" ? "text-bg-success" : "text-bg-danger")">@l.Event</span></td><td>@l.Ip</td><td>@if (l.UserId != null) { <a asp-action="UserDetail" asp-route-id="@l.UserId">View user</a> }</td></tr> }
  </tbody></table></div> }
</div>
