@model List<JobApplication>
@{ ViewData["Title"] = "My Applications"; }
<div class="container section">
  <h1>My Applications</h1>
  @if (Model.Count == 0) { <div class="empty">You have not applied for anything yet. <a asp-controller="Opportunities" asp-action="Index">Browse opportunities</a>.</div> }
  else { <div class="table-responsive"><table class="table align-middle ry-table"><thead><tr><th>Opportunity</th><th>Submitted</th><th>Status</th><th>Interview</th><th></th></tr></thead><tbody>
    @foreach (var a in Model) { <tr><td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@a.OpportunityId">@a.Opportunity?.Title</a></td><td>@a.SubmittedAt.ToLocalTime().ToString("d MMM yyyy")</td><td><span class="badge badge-cat">@a.Status</span></td><td>@(a.InterviewDate?.ToString("d MMM yyyy HH:mm") ?? "-")</td>
      <td>@if (a.Status is ApplicationStatus.Submitted or ApplicationStatus.UnderReview) { <form asp-action="Withdraw" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Withdraw this application?');"><button class="btn btn-sm btn-outline-danger">Withdraw</button></form> }</td></tr> }
  </tbody></table></div> }
</div>
