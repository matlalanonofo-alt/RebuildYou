@model ApplyVM
@{ ViewData["Title"] = "Apply: " + Model.Opportunity.Title; }
<div class="container section narrow">
  <h1>Apply: @Model.Opportunity.Title</h1><p class="text-muted-ry">@Model.Opportunity.EmployerName &middot; closes @Model.Opportunity.Deadline.ToString("d MMMM yyyy")</p>
  <div class="feature mb-4"><h2 class="h6">Your details</h2><p class="mb-0">@Model.User.FullName<br />@Model.User.Email &middot; @Model.User.PhoneNumber<br />@Model.User.City &middot; @Model.User.EducationLevel</p><a asp-controller="Account" asp-action="Profile" class="small">Update my profile</a></div>
  <form asp-action="Apply" asp-route-id="@Model.Opportunity.Id" method="post">
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <h2 class="h6">Select your CV</h2>
    @if (Model.Cvs.Count == 0) { <div class="alert alert-warning">You need to upload a CV first. <a asp-action="Cv">Upload CV</a></div> }
    @foreach (var c in Model.Cvs) { <div class="form-check"><input class="form-check-input" type="radio" name="CvId" id="cv@(c.Id)" value="@c.Id" checked="@(Model.CvId == c.Id)" /><label class="form-check-label" for="cv@(c.Id)">@c.OriginalFileName (@c.UploadedAt.ToLocalTime().ToString("d MMM yyyy"))</label></div> }
    @if (!string.IsNullOrWhiteSpace(Model.Opportunity.DocumentsRequired)) { <p class="small mt-3">Documents requested by the employer: @Model.Opportunity.DocumentsRequired</p> }
    <div class="mt-3"><label for="CoverNote" class="form-label">Short note to the recruiter (optional)</label><textarea id="CoverNote" name="CoverNote" rows="4" maxlength="1500" class="form-control">@Model.CoverNote</textarea></div>
    <div class="form-check mt-3"><input class="form-check-input" type="checkbox" name="Confirm" id="Confirm" value="true" /><label class="form-check-label" for="Confirm">I confirm that the information I have provided is accurate.</label></div>
    <button class="btn btn-ry btn-lg mt-4" disabled="@(Model.Cvs.Count == 0)">Submit application</button>
  </form>
</div>
