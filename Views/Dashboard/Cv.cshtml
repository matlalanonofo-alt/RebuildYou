@model List<CvDocument>
@{ ViewData["Title"] = "My CV"; }
<div class="container section narrow">
  <h1>My CV</h1>
  <p>Accepted formats: <strong>PDF or DOCX</strong>. Maximum size: <strong>5 MB</strong>. Your CV is stored privately. See our <a asp-controller="Home" asp-action="Privacy">privacy notice</a>.</p>
  <form asp-action="UploadCv" method="post" enctype="multipart/form-data" class="feature mb-4">
    <label for="file" class="form-label">Select File</label>
    <input id="file" name="file" type="file" accept=".pdf,.docx" class="form-control mb-3" required />
    <button class="btn btn-ry">@(Model.Count == 0 ? "Upload CV" : "Replace CV / Upload another")</button>
  </form>
  @if (Model.Count == 0) { <div class="empty">You have not uploaded a CV yet.</div> }
  else
  {
    <div class="table-responsive"><table class="table align-middle ry-table"><thead><tr><th>File</th><th>Uploaded</th><th>Size</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var c in Model) { <tr><td>@c.OriginalFileName</td><td>@c.UploadedAt.ToLocalTime().ToString("d MMM yyyy")</td><td>@(c.SizeBytes / 1024) KB</td><td><span class="badge text-bg-success">Uploaded</span></td>
      <td class="text-end"><a class="btn btn-sm btn-ry-outline" asp-action="DownloadCv" asp-route-id="@c.Id">Download My CV</a>
      <form asp-action="DeleteCv" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this CV?');"><button class="btn btn-sm btn-outline-danger">Delete My CV</button></form></td></tr> }
    </tbody></table></div>
  }
</div>
