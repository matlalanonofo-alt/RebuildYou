@model ProfileVM
@{ ViewData["Title"] = "My Profile"; }
<div class="container section narrow">
  <h1>My profile</h1>
  <form asp-action="Profile" method="post" novalidate>
    <div class="row g-3">
      <div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
      <div class="col-md-6"><label asp-for="Surname" class="form-label"></label><input asp-for="Surname" class="form-control" /><span asp-validation-for="Surname" class="text-danger"></span></div>
      <div class="col-md-6"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" /><span asp-validation-for="Mobile" class="text-danger"></span></div>
      <div class="col-md-6"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
      <div class="col-md-6"><label asp-for="EducationLevel" class="form-label"></label><select asp-for="EducationLevel" class="form-select" asp-items="@(new SelectList(Lists.Education))"><option value="">Select...</option></select></div>
      <div class="col-md-6"><label asp-for="EmploymentStatus" class="form-label"></label><select asp-for="EmploymentStatus" class="form-select" asp-items="@(new SelectList(Lists.Employment))"><option value="">Select...</option></select></div>
      <div class="col-md-6"><label asp-for="CareerInterests" class="form-label"></label><input asp-for="CareerInterests" class="form-control" /></div>
      <div class="col-md-6"><label asp-for="TrainingInterests" class="form-label"></label><input asp-for="TrainingInterests" class="form-control" /></div>
    </div>
    <button class="btn btn-ry mt-4">Save changes</button> <a class="btn btn-ry-outline mt-4" asp-action="ChangePassword">Change password</a>
  </form>
</div>
