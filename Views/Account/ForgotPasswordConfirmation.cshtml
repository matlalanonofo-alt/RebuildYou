@{ ViewData["Title"] = "Check your email"; }
<div class="container section narrow-sm">
  <h1>Check your email</h1>
  <p>If an active account uses that email address, we have sent a password-reset link. The link expires in one hour. If it does not arrive, check your spam folder or try again later.</p>
  <p><a asp-action="Login">Back to log in</a></p>
</div>
