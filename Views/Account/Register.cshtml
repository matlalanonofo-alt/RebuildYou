@model RegisterVM
@{ ViewData["Title"] = "Create your free profile"; }
<div class="container section narrow-sm">
  <h1>Create your free profile</h1>
  <p>One profile for all training, workshops and vacancies. It takes about a minute. You can add more details later.</p>
  <form asp-action="Register" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    @if (ViewBag.Exists == true) { <a class="btn btn-ry mb-3" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Go to Log in</a> }
    <div class="mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" autocomplete="given-name" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Surname" class="form-label"></label><input asp-for="Surname" class="form-control" autocomplete="family-name" /><span asp-validation-for="Surname" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" type="tel" inputmode="tel" autocomplete="tel" placeholder="e.g. 065 600 1164" /><span asp-validation-for="Mobile" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" inputmode="email" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Password" class="form-label"></label>
      <div class="input-group"><input asp-for="Password" class="form-control" autocomplete="new-password" /><button type="button" class="btn btn-ry-outline" data-pw="#Password">Show</button></div>
      <div class="form-text">At least 8 characters, with a capital letter, a small letter and a number.</div><span asp-validation-for="Password" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="AcceptPrivacy" class="form-check-input" /><label asp-for="AcceptPrivacy" class="form-check-label">I agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank">privacy notice and terms</a>.</label><br /><span asp-validation-for="AcceptPrivacy" class="text-danger"></span></div>
    <button class="btn btn-ry btn-lg w-100">Create my profile</button>
  </form>
  <p class="mt-3">Already have a profile? <a asp-action="Login">Log in</a></p>
</div>
