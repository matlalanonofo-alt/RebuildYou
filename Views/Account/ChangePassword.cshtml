@model ChangePasswordVM
@{ ViewData["Title"] = "Change Password"; }
<div class="container section narrow-sm">
  <h1>Change password</h1>
  <form asp-action="ChangePassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="mb-3"><label asp-for="Current" class="form-label"></label><input asp-for="Current" class="form-control" autocomplete="current-password" /><span asp-validation-for="Current" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="New" class="form-label"></label><input asp-for="New" class="form-control" autocomplete="new-password" /><span asp-validation-for="New" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Confirm" class="form-label"></label><input asp-for="Confirm" class="form-control" autocomplete="new-password" /><span asp-validation-for="Confirm" class="text-danger"></span></div>
    <button class="btn btn-ry">Change password</button>
  </form>
</div>
